<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Razor Pages Lab</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <nav class="container navigation" aria-label="Primary navigation">
            <a class="brand" asp-page="/Index">Razor Pages Lab</a>
            <a asp-page="/Index">Workshops</a>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="container site-footer">
        <p>Phase 8: Razor syntax and Razor Pages</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
