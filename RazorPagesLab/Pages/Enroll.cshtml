@page "{workshopId:int}"
@model RazorPagesLab.Pages.EnrollModel
@{
    ViewData["Title"] = "Enroll";
}

@if (Model.Workshop is null)
{
    <h1>Workshop not found</h1>
    <p>The selected workshop does not exist.</p>
}
else
{
    <section class="form-card">
        <p class="eyebrow">Enrollment form</p>
        <h1>Enroll in @Model.Workshop.Title</h1>
        <p>@Model.Workshop.Description</p>

        <form method="post">
            @* The form and validation Tag Helpers generate names, IDs, and an
               antiforgery token that matches the PageModel properties. *@
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <input asp-for="WorkshopId" type="hidden" />

            <div class="form-field">
                <label asp-for="Input.FullName"></label>
                <input asp-for="Input.FullName" autocomplete="name" />
                <span asp-validation-for="Input.FullName" class="field-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <button class="button" type="submit">Submit enrollment</button>
        </form>
    </section>
}
